# ==========================================
# AgentTrust Configuration
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True

# Database:
# For zero-config local development, default SQLite database is automatically used:
DATABASE_URL=sqlite+aiosqlite:///./agenttrust.db
# For PostgreSQL / Docker:
# DATABASE_URL=postgresql+asyncpg://agenttrust:agenttrust_secret@localhost:5432/agenttrust

# AI / LLM Provider:
# Options: "mock" (default, runs fully offline with deterministic judge) | "openai" | "openai_compatible"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Translation Provider:
# Options: "mock" (default rule-based offline back-translator) | "llm"
TRANSLATION_PROVIDER=mock

# Execution & Concurrency
MAX_CONCURRENCY=4
EVALUATION_TIMEOUT_SEC=60
RETRY_COUNT=2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
