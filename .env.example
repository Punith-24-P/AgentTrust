# ==========================================
# AgentTrust Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Authentication & Security
JWT_SECRET=super-secret-agenttrust-token-signing-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite development (default zero-config):
DATABASE_URL=sqlite+aiosqlite:///./agenttrust.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://agenttrust:agenttrust_secret@localhost:5432/agenttrust

# AI / LLM Provider Configuration
# Options: "mock" (offline rule-based deterministic judge) | "openai" | "openai_compatible"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Translation Provider Configuration
# Options: "mock" (offline translation fidelity analyzer) | "llm"
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=

# Execution & Concurrency
MAX_CONCURRENCY=4
EVALUATION_TIMEOUT_SEC=60
RETRY_COUNT=2

# Networking & URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
